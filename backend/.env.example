# Copy this file to .env and fill in the values. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./aspira.db

# Must be 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Get a key at https://aistudio.google.com (Get API key)
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.8-flash

MAX_USERS=50
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SRS FR-EV-01: tasks become completed only through accepted evidence (default: true).
# The two-week demo has no evidence service yet, so set this to false in YOUR local .env
# to let users mark tasks Finished / Incomplete themselves.
EVIDENCE_REQUIRED=true